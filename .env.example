# Copy to .env and fill in. Never commit .env.
# Notifier bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Recipients: chat ids, comma-separated (each person presses Start in the bot, then read getUpdates)
TELEGRAM_CHAT_ID=

# Telegram user account that reads the sources: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Optional
# CONFIG_PATH=config.toml
# STATE_DIR=state
# POLL_SECS=60
